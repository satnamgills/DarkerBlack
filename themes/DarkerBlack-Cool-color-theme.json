{
	"name": "DarkerBlack Cool Blue",
	"type": "dark",
	"semanticHighlighting": true,
	"colors": {
		"editor.background": "#000000",
		"editor.foreground": "#E0E0FF",
		"editorCursor.foreground": "#00BBFF",
		"editor.lineHighlightBackground": "#050510",
		"editor.selectionBackground": "#102040",
		"editor.inactiveSelectionBackground": "#0A1020",
		"editorWhitespace.foreground": "#202040",
		"editorIndentGuide.background": "#202040",
		"editorIndentGuide.activeBackground": "#404080",
		"editorLineNumber.foreground": "#404060",
		"editorLineNumber.activeForeground": "#00BBFF",
		"activityBar.background": "#000000",
		"activityBar.foreground": "#00BBFF",
		"activityBar.border": "#101030",
		"sideBar.background": "#000000",
		"sideBar.foreground": "#A0A0C0",
		"sideBar.border": "#101030",
		"sideBarTitle.foreground": "#00BBFF",
		"sideBarSectionHeader.background": "#000000",
		"sideBarSectionHeader.foreground": "#E0E0FF",
		"statusBar.background": "#000000",
		"statusBar.foreground": "#E0E0FF",
		"statusBar.border": "#101030",
		"statusBar.debuggingBackground": "#8000FF",
		"titleBar.activeBackground": "#000000",
		"titleBar.activeForeground": "#E0E0FF",
		"titleBar.inactiveBackground": "#000000",
		"titleBar.inactiveForeground": "#606080",
		"titleBar.border": "#101030",
		"tab.activeBackground": "#000000",
		"tab.activeForeground": "#00BBFF",
		"tab.activeBorderTop": "#00BBFF",
		"tab.inactiveBackground": "#000000",
		"tab.inactiveForeground": "#606080",
		"tab.border": "#101030",
		"list.activeSelectionBackground": "#050515",
		"list.activeSelectionForeground": "#00BBFF",
		"list.hoverBackground": "#050515",
		"list.hoverForeground": "#E0E0FF",
		"terminal.background": "#000000",
		"terminal.foreground": "#E0E0FF",
		"widget.shadow": "#000000",
		"focusBorder": "#00BBFF"
	},
	"tokenColors": [
		{
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": {
				"foreground": "#505070",
				"fontStyle": "italic"
			}
		},
		{
			"scope": ["variable", "string constant.other.placeholder"],
			"settings": {
				"foreground": "#E0E0FF"
			}
		},
		{
			"scope": ["constant.other.color"],
			"settings": {
				"foreground": "#00BBFF"
			}
		},
		{
			"scope": ["invalid", "invalid.illegal"],
			"settings": {
				"foreground": "#FF3366"
			}
		},
		{
			"scope": ["keyword", "storage.type", "storage.modifier"],
			"settings": {
				"foreground": "#8080FF"
			}
		},
		{
			"scope": ["keyword.control"],
			"settings": {
				"foreground": "#8080FF",
				"fontStyle": "bold"
			}
		},
		{
			"scope": ["keyword.operator", "punctuation"],
			"settings": {
				"foreground": "#00BBFF"
			}
		},
		{
			"scope": ["function", "support.function", "entity.name.function"],
			"settings": {
				"foreground": "#00E0FF"
			}
		},
		{
			"scope": ["entity.name.type", "entity.name.class", "support.class", "support.type"],
			"settings": {
				"foreground": "#AA88FF"
			}
		},
		{
			"scope": ["string"],
			"settings": {
				"foreground": "#00FFCC"
			}
		},
		{
			"scope": ["constant.numeric", "constant.language", "constant.character", "constant.escape"],
			"settings": {
				"foreground": "#CC99FF"
			}
		},
		{
			"scope": ["variable.parameter"],
			"settings": {
				"foreground": "#66AAFF"
			}
		},
		{
			"scope": ["entity.name.tag"],
			"settings": {
				"foreground": "#8080FF"
			}
		},
		{
			"scope": ["entity.other.attribute-name"],
			"settings": {
				"foreground": "#00E0FF"
			}
		},
		{
			"scope": ["markup.heading"],
			"settings": {
				"foreground": "#8080FF",
				"fontStyle": "bold"
			}
		},
		{
			"scope": ["markup.bold"],
			"settings": {
				"fontStyle": "bold"
			}
		},
		{
			"scope": ["markup.italic"],
			"settings": {
				"fontStyle": "italic"
			}
		},
		{
			"scope": ["markup.inserted"],
			"settings": {
				"foreground": "#00FFCC"
			}
		},
		{
			"scope": ["markup.deleted"],
			"settings": {
				"foreground": "#FF3366"
			}
		},
		{
			"scope": ["markup.changed"],
			"settings": {
				"foreground": "#AA88FF"
			}
		}
	]
}
