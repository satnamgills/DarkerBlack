{
	"name": "DarkerBlack Vibrant",
	"type": "dark",
	"semanticHighlighting": true,
	"colors": {
		"editor.background": "#000000",
		"editor.foreground": "#FFFFFF",
		"editorCursor.foreground": "#00E5FF",
		"editor.lineHighlightBackground": "#111111",
		"editor.selectionBackground": "#264F78",
		"editor.inactiveSelectionBackground": "#1a2b3c1a",
		"editorWhitespace.foreground": "#303030",
		"editorIndentGuide.background1": "#303030",
		"editorIndentGuide.activeBackground1": "#505050",
		"editorLineNumber.foreground": "#505050",
		"editorLineNumber.activeForeground": "#FFFFFF",
		"activityBar.background": "#000000",
		"activityBar.foreground": "#00E5FF",
		"activityBar.border": "#333333",
		"sideBar.background": "#000000",
		"sideBar.foreground": "#CCCCCC",
		"sideBar.border": "#333333",
		"sideBarTitle.foreground": "#00E5FF",
		"sideBarSectionHeader.background": "#000000",
		"sideBarSectionHeader.foreground": "#FFFFFF",
		"statusBar.background": "#000000",
		"statusBar.foreground": "#FFFFFF",
		"statusBar.border": "#333333",
		"statusBar.debuggingBackground": "#FF00FF",
		"titleBar.activeBackground": "#000000",
		"titleBar.activeForeground": "#FFFFFF",
		"titleBar.inactiveBackground": "#000000",
		"titleBar.inactiveForeground": "#888888",
		"titleBar.border": "#333333",
		"tab.activeBackground": "#000000",
		"tab.activeForeground": "#00E5FF",
		"tab.activeBorderTop": "#00E5FF",
		"tab.inactiveBackground": "#000000",
		"tab.inactiveForeground": "#888888",
		"tab.border": "#333333",
		"list.activeSelectionBackground": "#111111",
		"list.activeSelectionForeground": "#00E5FF",
		"list.hoverBackground": "#111111",
		"list.hoverForeground": "#FFFFFF",
		"terminal.background": "#000000",
		"terminal.foreground": "#FFFFFF",
		"widget.shadow": "#000000",
		"focusBorder": "#00E5FF",
		"menu.background": "#000000",
		"menu.foreground": "#51edfe",
		"menu.border": "#333333",
		"scrollbar.shadow": "#000000",
		"scrollbarSlider.background": "#00E5FF",
		"scrollbarSlider.hoverBackground": "#00E5FF",
		"scrollbarSlider.activeBackground": "#00E5FF",
		"progressBar.background": "#00E5FF",
		"notificationCenterHeader.background": "#000000",
		"notificationCenterHeader.foreground": "#00E5FF",
		"notificationToast.border": "#333333",
		
	},
	"tokenColors": [
		{
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": {
				"foreground": "#757575",
				"fontStyle": "italic"
			}
		},
		{
			"scope": ["variable", "string constant.other.placeholder"],
			"settings": {
				"foreground": "#FFFFFF"
			}
		},
		{
			"scope": ["constant.other.color"],
			"settings": {
				"foreground": "#00E5FF"
			}
		},
		{
			"scope": ["invalid", "invalid.illegal"],
			"settings": {
				"foreground": "#FF0000"
			}
		},
		{
			"scope": ["keyword", "storage.type", "storage.modifier"],
			"settings": {
				"foreground": "#FF00FF"
			}
		},
		{
			"scope": ["keyword.control"],
			"settings": {
				"foreground": "#FF00FF",
				"fontStyle": "bold"
			}
		},
		{
			"scope": ["keyword.operator", "punctuation"],
			"settings": {
				"foreground": "#00E5FF"
			}
		},
		{
			"scope": ["function", "support.function", "entity.name.function"],
			"settings": {
				"foreground": "#00E5FF"
			}
		},
		{
			"scope": ["entity.name.type", "entity.name.class", "support.class", "support.type"],
			"settings": {
				"foreground": "#FFC400"
			}
		},
		{
			"scope": ["string"],
			"settings": {
				"foreground": "#FFFF00"
			}
		},
		{
			"scope": ["constant.numeric", "constant.language", "constant.character", "constant.escape"],
			"settings": {
				"foreground": "#D500F9"
			}
		},
		{
			"scope": ["variable.parameter"],
			"settings": {
				"foreground": "#FF9100"
			}
		},
		{
			"scope": ["entity.name.tag"],
			"settings": {
				"foreground": "#FF00FF"
			}
		},
		{
			"scope": ["entity.other.attribute-name"],
			"settings": {
				"foreground": "#00E676"
			}
		},
		{
			"scope": ["markup.heading"],
			"settings": {
				"foreground": "#FF00FF",
				"fontStyle": "bold"
			}
		},
		{
			"scope": ["markup.bold"],
			"settings": {
				"fontStyle": "bold"
			}
		},
		{
			"scope": ["markup.italic"],
			"settings": {
				"fontStyle": "italic"
			}
		},
		{
			"scope": ["markup.inserted"],
			"settings": {
				"foreground": "#00E676"
			}
		},
		{
			"scope": ["markup.deleted"],
			"settings": {
				"foreground": "#FF1744"
			}
		},
		{
			"scope": ["markup.changed"],
			"settings": {
				"foreground": "#FFC400"
			}
		}
	]
}
