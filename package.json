{
  "name": "darkerblack",
  "displayName": "DarkerBlack",
  "description": "Beautiful dark theme for vs code",
  "version": "1.0.0",
  "pricing": "Free",
  "publisher": "satnamgills",
  "repository": {
    "type": "git",
    "url": "https://github.com/satnamgills/darkerblack"
  },
  "author": {
    "name": "Satnam Singh",
    "email": "satnamgills@gmail.com"
  },
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Themes"
  ],
  "scripts": {
    "deploy": "vsce publish --yarn"
  },
  "contributes": {
    "themes": [
      {
        "label": "DarkerBlack Vibrant",
        "uiTheme": "vs-dark",
        "path": "./themes/DarkerBlack-color-theme.json"
      },
      {
        "label": "DarkerBlack Cool Blue",
        "uiTheme": "vs-dark",
        "path": "./themes/DarkerBlack-Cool-color-theme.json"
      },
      {
        "label": "DarkerWhite",
        "uiTheme": "vs",
        "path": "./themes/DarkerWhite-color-theme.json"
      }
    ]
  },
  "devDependencies": {
    "@vscode/vsce": "^3.7.1"
  }
